{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://flowfex.onrender.com/api/:path*" },
    { "source": "/connect/:path*", "destination": "https://flowfex.onrender.com/api/connect/:path*" },
    { "source": "/connect", "destination": "https://flowfex.onrender.com/api/connect" },
    { "source": "/ingest", "destination": "https://flowfex.onrender.com/ingest" },
    { "source": "/sessions/:path*", "destination": "https://flowfex.onrender.com/sessions/:path*" },
    { "source": "/session/:path*", "destination": "https://flowfex.onrender.com/session/:path*" },
    { "source": "/control/:path*", "destination": "https://flowfex.onrender.com/control/:path*" },
    { "source": "/orchestration/:path*", "destination": "https://flowfex.onrender.com/orchestration/:path*" },
    { "source": "/node/:path*", "destination": "https://flowfex.onrender.com/node/:path*" },
    { "source": "/skills", "destination": "https://flowfex.onrender.com/skills" },
    { "source": "/skills/:path*", "destination": "https://flowfex.onrender.com/skills/:path*" },
    { "source": "/catalog/:path*", "destination": "https://flowfex.onrender.com/catalog/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
